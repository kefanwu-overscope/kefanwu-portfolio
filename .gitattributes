# never let autocrlf touch binary assets
*.pdf binary
*.webp binary
*.glb binary
*.gltf text
*.hdr binary
*.png binary
*.jpg binary
*.zip binary
*.bin binary

# Keep verified upstream/generated bytes, including their original whitespace.
tools/hdr/vendor/** -text -whitespace
tools/lod/vendor/** -text -whitespace
experience-hdr-worker.js -text -whitespace
